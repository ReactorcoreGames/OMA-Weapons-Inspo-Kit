RealisticParams_556mm.WeaponModes=((ModeName="Flamethrower"),(ModeName="Healing Gas"),)

[CX61WeaponParamsTactical]
TacticalParams.WeaponModes=((ModeName="Flamethrower"),(ModeName="Healing Gas"),)
TacticalParams_Spike.WeaponModes=((ModeName="Flamethrower"),(ModeName="Healing Gas"),)

[CX85AssaultWeapon]
WeaponModes=((ModeName="Semi"),(ModeName="Burst"),(ModeName="Auto"))
ManualLines=("Automatic low-calibre fire. Has extremely long effective range, but as a low-calibre weapon, must be fired in bursts at range, subjecting the user to the effects of recoil.","Fires a dart. Good fire rate and fast flight speed. Enemies hit by the darts show up on the scope when within a given range of the user. The tracking range increases with successive hits.","Weapon Function for this weapon causes all the darts attached to the last player to be hit for the first time to explode. This feature works independently of range.||The CX85 is effective at long range.")
Description="The Cimerion Labs CX85 was created to serve the purpose of enemy location and tracking in a battlefield environment where operatives needed tactical-level information on enemy positions and movements without the ability to rely upon allied intelligence. Capable of launching miniature darts, each packed with an explosive charge and a remote transmitter, the CX is able to discern the location of struck enemies. Should the user no longer have need for the tracking ability, the darts can be detonated at long range to damage the target and surrounding entities."
ItemName="CX85 Combat Rifle"

[CX85Pickup]
PickupMessage="You picked up the CX85 assault weapon."

