ClassicParams.WeaponModes=((ModeName="Semi"),(ModeName="Burst"),(ModeName="Auto"))

[SRKSmgWeaponParamsRealistic]
RealisticParams.WeaponModes=((ModeName="Semi"),(ModeName="Burst"),(ModeName="Auto"))

