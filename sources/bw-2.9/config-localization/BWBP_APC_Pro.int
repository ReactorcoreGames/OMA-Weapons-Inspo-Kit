[DTE5Laser]
DeathStrings=("%o had %vh lower spine beamed in half by %k's ASP.","%k carved %kh name in %o's stomach with a mini plasma pistol.","%o's fingers made for good finger food for %k's viper.","%o took %k's small but potent beam to the groin.","%k burrowed a decent sized hole into %o's belly despite %kh pistol being miniature.")
SimpleKillString="E-5 'ViPeR' Laser"
AimedString="Scoped"
DeathString="%o was burnt in two by %k's sacred fire."
FemaleSuicide="%o accidentally scorched her own legs off with the E-5 laser."
MaleSuicide="%o accidentally scorched his own legs off with the E-5 laser."

[DTE5LaserHead]
DeathStrings=("%o had %vh head decapitated by %k's miniature beam of death.","%k gave %o a plasma power tracheostomy, still was fatal though.","%o didn't read the fine print before getting lethal eye laser surgery by Dr. %k.","%k drew a smiley face on %o before dying, %ve didn’t appreciate it.")
SimpleKillString="E-5 'ViPeR' Laser"
AimedString="Scoped"
DeathString="%k swept %kh ViPeR laser across %o's stunned face."
FemaleSuicide="%o scorched her own head off with an E-5."
MaleSuicide="%o scorched his own head off with an E-5."

[DTE5Plasma]
DeathStrings=("%o got pricked by %k's miniature viper, it still was lethal.","%k's plasma pistol might be small, but still burned a hole through %o's thorax.","%o got bit by %k's viper in the leg, not even a plasma amputation could save them.","%k eventually put %o to rest after blasting them with a plasma pistol repeatedly.","%o ran into all of %k's small bolts of plasma doom.")
DeathString="%k melted a burning hole through %o with the E-5 ViPeR."
FemaleSuicide="%o's ASP bit her in half."
MaleSuicide="%o's ASP bit him in half."

[DTE5PlasmaHead]
DeathStrings=("%o had their brain imprinted with %k's plasma bolts and death.","%k sunk their viper's fangs into %o's skull and injected them with plasma.","%o's visage turned into glowing syrup thanks to %k's miniature viper.","%k ripped open a yellow portal right through %o's face.","There's no antivenom for %o to take after getting blasted by %k's plasma viper.")
DeathString="%k left %o stumped with %kh E-5."
FemaleSuicide="%o stumped herself with the E-5."
MaleSuicide="%o stumped himself with the E-5."

[DTE5Shotgun]
DeathStrings=("%o fell down after taking %k's ring of plasma bolts to the chest.","%k was in spitting distance to spit some plasma bolts towards %o.","%o has several scorching holes as a gift from %k.","%k's viper sunk it's fangs into %o's ribcage.","%o's limbs atrophied after getting bit by %k.")
DeathString="%k melted a burning hole through %o with the E-5 ViPeR."
FemaleSuicide="%o's ASP bit her in half."
MaleSuicide="%o's ASP bit him in half."

[DTE5ShotgunHead]
DeathStrings=("%o's head was pumped full of %k's plasma until it exploded in a ball of light.","%k filled %o's head with shotgun pulses before %ve succumbed to the ASP.","%o's mind was full of thoughts and dreams, now it's home to %k's plasma bolts.","%k sicced %kh ASP on %o, biting %vh head off.")
