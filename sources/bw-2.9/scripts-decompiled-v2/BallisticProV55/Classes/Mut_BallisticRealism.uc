class Mut_BallisticRealism extends Mut_BallisticStyle
	hidecategories(Movement,Collision,Lighting,LightColor,Karma,Force);

defaultproperties
{
	OverrideStyle=2
	ConfigMenuClassName="BallisticProV55.MutConfigMenu_Realism"
	FriendlyName="Ballistic Weapons: Realism Style"
	Description="Applies the Realism style of the Ballistic Weapons mod, which replaces the game's weaponset and behaviours with more realistic ones.||This style is based around realism, with a slower place of play.||This style can be configured extensively using the Mutator menu."
}
