[BallisticShieldPickup]
PickupMessage="You picked up a ballistic shield."

[BallisticShieldWeapon]
ManualLines=("Attacks with the weapon and shield. The shield continues to block whilst attacking.","Prepared strike with the weapons.","Hold Weapon Function to block with the shield, which dramatically increases its defensive effectiveness at the cost of your ability to see. The shield is further bolstered in effectiveness if the user is crouching while blocking.||The ballistic shield reduces movement speed whilst active.")
Description="RSH-1034 Riot Shield||Manufacturer: Apollo Industries|Primary: Smash|Secondary: Prepared Bash||A defensive weapon capable of blocking many attack types. Reduces incoming frontal damage by 35 or reduces it to 25% of the original amount, whichever is greater. Blocks melee damage outright. Has no effect on non-locational damage such as gas and fire."
ItemName="RSH-1034 Riot Shield"

[CX61AssaultRifle]
WeaponModes=((ModeName="Flamethrower"),(ModeName="Healing Gas"),(ModeName="Auto"))
ManualLines=("Automatic fire. Lower damage output than other assault rifles, but more controllable.","Flamethrower mode launches a stream of fire, dealing minor damage to enemies and causing disorientation.|Healing Gas mode sprays G28 gas, granting health to allies.","It is recommended to check which mode of the CX is active before engaging the altfire. Burning allies or healing enemies is not conducive to survival.||The CX61 is effective at close to medium range.")
Description="Cimerion Labs' CX61 Tactical Rifle was engineered as a reliable primary weapon for use by medical personnel. Incorporating a nano-forge capable of producing G28 aerosol for projection by the weapon, it is able to choose between projecting healing spray or igniting the G28 gas in order to emit a blast of flame to disorient foes."
ItemName="CX61 Tactical Rifle"

[CX61Pickup]
PickupMessage="You picked up the CX61 tactical rifle."

[CX61WeaponParamsClassic]
ClassicParams.WeaponModes=((ModeName="Flamethrower"),(ModeName="Healing Gas"),)
ClassicParams_556mm.WeaponModes=((ModeName="Flamethrower"),(ModeName="Healing Gas"),)

[CX61WeaponParamsComp]
ArenaParams.WeaponModes=((ModeName="Flamethrower"),(ModeName="Healing Gas"),)
ArenaParams_Spike.WeaponModes=((ModeName="Flamethrower"),(ModeName="Healing Gas"),)

[CX61WeaponParamsRealistic]
