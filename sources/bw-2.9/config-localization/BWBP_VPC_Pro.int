[KHMKII]
VehiclePositionString="Flying a KH MarkII"
VehicleNameString="KH MarkII Cobra"

[KHMKIIDamTypeBarrage]
DeathStrings=("%o couldn't stop dancing in %k's Missile rain.","%o got caught in %k's fire rain.","%k's TOW Missiles helped %o loosen up.","%o couldn't get out of %k's firestorm.")
FemaleSuicides=("%o couldn't get enough of her own Missile rain.","%o's fire barrage button got stuck, or so she says.","%o defied the laws of physics and caught her own Missiles.","%o proved why children shouldn't play with loaded Cobras.")
MaleSuicides=("%o couldn't get enough of his own Missile rain.","%o's fire barrage button got stuck, or so he says.","%o defied the laws of physics and caught his own Missiles.","%o proved why children shouldn't play with loaded Cobras.")

[KHMKIIDamTypeMinigun]
DeathStrings=("%o is now leaking like a colander thanks to %k's Cobra machinegun.","%k's Cobra machinegun punctured %o like a pin cushion.","%o couldn't take the number of holes that %k's Cobra machinegun delivered.")
FemaleSuicides=("%o shot herself with a Cobra machinegun in hopes of becoming a colander.","%o was all too curious when it came to inspecting Cobra machinegun barrels.")
MaleSuicides=("%o shot himself with a Cobra machinegun in hopes of becoming a colander.","%o was all too curious when it came to inspecting Cobra machinegun barrels.")

[KHMKIIDamTypePancake]
DeathStrings=("%o squealed like a pig when trapped under %k's landing bars.","%o was pinned down by %k's landing bars.","%o got pasted to the ground by %k's landing bars.")
FemaleSuicides=("%o got her moronic self trapped under her own landing bars.","%o got rolled on by her own Cobra.","%o wasn't watching the skies for the Cobra she abandoned.")
MaleSuicides=("%o got his moronic self trapped under his own landing bars.","%o got rolled on by his own Cobra.","%o wasn't watching the skies for the Cobra he abandoned.")

[KHMKIIDamTypeRoadKill]
DeathStrings=("%o lept into %k's rotor blades.","%k's rotor blades satisfied %o's craving for sushi.","%k's landing bars caught a foreign object called %o.","%o should have checked both sides of the road for %k's Cobra.")
FemaleSuicides=("%o made sushi of herself.","%o forget to put her Cobra's handbrake on.")
MaleSuicides=("%o made sushi of himself.","%o forget to put his Cobra's handbrake on.")

[KHMKIIDamTypeRocket]
DeathStrings=("%o got caught in %k's underTOW.","%o's limp body got TOWed away by %k.","%o with his foot fetish mistook %k's TOW for a toe.","%o was splattered like so many spanish tomatos by %k's TOW Missiles.")
FemaleSuicides=("%o stuck her ugly face infront of her own TOW Missiles.","%o was inspecting the integrity of her TOW Missiles with her obscene face.","%o got carried away with the little red button that launches TOW Missiles.","%o proved why children shouldn't play with loaded Cobras.")
MaleSuicides=("%o stuck his ugly face infront of his own TOW Missiles.","%o was inspecting the integrity of his TOW Missiles with his obscene face.","%o got carried away with the little red button that launches TOW Missiles.","%o proved why children shouldn't play with loaded Cobras.")

