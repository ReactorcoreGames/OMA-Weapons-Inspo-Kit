Weapon=(ClassName=BWBPAirstrikesPro.TargetDesignator,PickupClassName=BWBPAirstrikesPro.TargetDesignatorPickup,AttachmentClassName=BWBPAirstrikesPro.TargetDesignatorAttachment,FriendlyName=BWBPAirstrikesPro.TargetDesignator.ItemName,Description=BWBPAirstrikesPro.TargetDesignator.Description,FallbackName="MAU-52 Target Designator",FallbackDesc="The Target Designator is a unique weapon which can call in various types of airstrike on a position by using Target Painter mechanics. This weapon is of no use in environments where there is no access to the sky.")