[LeopardDamType50Calibre]
DeathStrings=("%o was drilled by %k's TMV .50 Calibre machinegun.","%k's TMV .50 Cal softened %o into a lifeless pile.","%o couldn't hide before %k's TMV .50 Cal got him down.","%o was overcome by the power of %k's TMV .50 Cal.")
