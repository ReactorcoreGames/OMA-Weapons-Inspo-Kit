[A49Pickup]
PickupMessage="You picked up the A49 Skrith blaster."

[A49SkrithBlaster]
WeaponModes=((ModeName="Semi"),(ModeName="Burst"),(ModeName="Auto"))
ManualLines=("Fires a stream of plasma projectiles. These projectiles deal high damage and gain damage over range, but are slow.||Using this mode generates heat, and if the weapon overheats, the user will take damage and the fire rate is reduced.","Projects a short-range shockwave, dealing low damage and pushing nearby enemies back.||Using this mode generates significant heat, and if the weapon overheats, the user will take damage.","Effective at close range. Especially effective at repelling charges and melee.")
Description="A49 Skrith Blaster"
ItemName="A49 Skrith Blaster"

