class ONSHeadlightProjector extends Projector
	native;

defaultproperties
{
	MaterialBlendingOp=1
	FrameBufferBlendingOp=3
	FOV=40
	MaxTraceDistance=2048
	bClipBSP=true
	bProjectOnUnlit=true
	bGradient=true
	bProjectOnAlpha=true
	bProjectOnParallelBSP=true
	bDynamicAttach=true
	bNoProjectOnOwner=true
	CullDistance=2000.0000000
	bLightChanged=true
	bStatic=false
	bDetailAttachment=true
	DrawScale=0.6500000
	bHardAttach=true
}
