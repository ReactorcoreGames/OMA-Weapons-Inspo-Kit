class DamTypePRVCombo extends VehicleDamageType
	abstract;

defaultproperties
{
	VehicleClass=Class'Onslaught.ONSPRVSideGunPawn'
	DeathString="%o couldn't escape the awesome power of %k's skymine combo."
	FemaleSuicide="%o was a little hasty detonating her skymines."
	MaleSuicide="%o was a little hasty detonating his skymines."
	ThemSuicide="%o was a little hasty detonating their skymines."
	bDelayedDamage=true
	VehicleDamageScaling=0.7500000
	VehicleMomentumScaling=0.5000000
}
