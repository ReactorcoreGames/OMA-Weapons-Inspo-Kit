[TargetDesignator]
WeaponModes=((ModeName="Carpet Bombing"),(ModeName="CBU-100 Cluster Bomb"),(ModeName="GBU-57 MOP"),(ModeName="AGM-154 JSOW"),(ModeName="MLRS Rocket Barrage"))
ManualLines=("Projects a laser, which must be kept aimed at a given point on the map to call in the active airstrike.","Raises the scope. The color of the scope changes from green to red, depending on whether or not the player is sufficiently far away from the aim point to call in the current airstrike.","Switch modes by holding down the Fire Mode key and scrolling the mouse.||Effective at medium range. Extremely effective at long range, against cover, and against groups.")
Description="The Target Designator is a unique weapon which can call in various types of airstrike on a position by using Target Painter mechanics. This weapon is of no use in environments where there is no access to the sky."
ItemName="MAU-52 Target Designator"

[TargetDesignatorPickup]
PickupMessage="You picked up the MAU-52 Target Designator."

[X93Painter]
Description="The X-93A Orbital Weapon Designator is the most spectacular weapon in the Tournament's inventory. An upgraded version of the VAPOR WeP orbital ion cannon, the X-93A sports a wider blast area, longer designation distance, and a color shift from pink to blue due to the usage of ions traveling at lower velocity but with greater mass."
ItemName="X-93A Orbital Weapon Designator"

[X93PainterPickup]
PickupMessage="You got the X-93A Orbital Weapon Designator."

