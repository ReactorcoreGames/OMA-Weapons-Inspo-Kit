MaleSuicides=("%o shot himself with a TMV .50 Cal.","%o was all too curious when it came to inspecting TMV .50 Cal barrels.")

[LeopardDamTypePancake]
DeathStrings=("%o should have looked up in case of %k's flying TMV.","%o's head was shaved by %k's TMV tracks.","%o got pasted to the ground by %k's TMV underside.")
FemaleSuicides=("%o should have been more carefull when abandoning her TMV on the edge of a precipice.","%o got rolled on by her own TMV.")
MaleSuicides=("%o should have been more carefull when abandoning his TMV on the edge of a precipice.","%o got rolled on by his own TMV.")

[LeopardDamTypeRoadKill]
DeathStrings=("%o was tenderized by %k's TMV Tracks.","%k's TMV tracks caught %o in a lock.","%k's TMV tracks ground %o's twig like bones.","%k's TMV tracks proved why children like %o shouldn't walk off road.","%o couldn't run from %k's scary TMV tracks.","%o's boney little arms got stuck in %k's TMV engine cogs.","%o got aquainted with %k's TMV tracks.")
FemaleSuicides=("%o made one fine peice of tenderized steak out of herself.","%o forget to put her TMV's handbrake on.")
MaleSuicides=("%o made one fine peice of tenderized steak out of himself.","%o forget to put his TMV's handbrake on.")

[LeopardDamTypeShell]
DeathStrings=("%o was popped by %k's TMV Shell.","%k's TMV Shell turned %o into a crispy critter.","%o pulled off a 'flying grass hopper' impression with the aid of %k's TMV Shell.","%o saw the pretty light's of %k's TMV Shell.","%o was splattered like so many italian tomatos by %k's TMV Shell.")
FemaleSuicides=("%o's TMV and it's fire button where all too big for her childish self.","%o tried to shoot through walls with her TMV Shell.","%o blew her top off with a TMV Shell.")
MaleSuicides=("%o's TMV and it's fire button where all too big for his childish self.","%o tried to shoot through walls with his TMV Shell.","%o blew his top off with a TMV Shell.")

