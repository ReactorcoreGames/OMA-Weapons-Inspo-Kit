RealisticParams_Irons.WeaponModes=((ModeName="Semi-Auto"),(ModeName="Burst Fire"),(ModeName="Full Auto"))

[LS14Carbine]
WeaponModes=((ModeName="Single Barrel"),(ModeName="Double Barrel"),(ModeName="Automatic"))
ManualLines=("Single Fire mode fires one barrel at once for low damage, with good fire rate.||Double Fire fires both barrels, for moderate damage, with low fire rate.||Both modes heat up the target, causing subsequent shots to inflict greater damage. This effect on the target decays with time.","Launches miniature rockets. These rockets deal high damage and good radius damage. The rockets have a short period of low speed before igniting.","Effective at long range and against enemies using healing weapons and items.")
Description="LS-14 Laser Carbine||Manufacturer: UTC Defense Tech|Primary: Focused Photon Beam|Secondary: Mini Rockets"
ItemName="LS-14 Laser Rifle"

[LS14Pickup]
PickupMessage="You picked up the LS-14 laser carbine."

